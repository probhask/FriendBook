# ---- Browser (Vite) — safe to expose, embedded in the client bundle ----
VITE_SANITY_PROJECT_ID=us9jlw19
VITE_SANITY_DATASET=production
# Optional. If your dataset is private, create a **viewer / read-only** token
# in Sanity → API → Tokens and put it here. NEVER a write/deploy token.
VITE_SANITY_READ_TOKEN=

# ---- Server only (Netlify Functions) — NEVER prefixed with VITE_ ----
SANITY_PROJECT_ID=us9jlw19
SANITY_DATASET=production
SANITY_API_VERSION=2024-06-10
# Editor/write token from Sanity → API → Tokens.
SANITY_WRITE_TOKEN=
# Long random string used to sign session cookies, e.g. `openssl rand -hex 32`.
JWT_SECRET=
